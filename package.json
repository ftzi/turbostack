{
	"name": "turbostack",
	"version": "1.0.0",
	"packageManager": "bun@1.3.3",
	"scripts": {
		"dev": "bun ./packages/tools/setup-dev.ts && bun i && turbo dev tsw",
		"dev:e2e": "bun ./packages/tools/setup-dev.ts && bun i && turbo dev",
		"dev:email": "turbo dev:email",
		"mobile": "bun run --cwd apps/mobile dev",
		"mobile:web": "bun run --cwd apps/mobile web",
		"mobile:ios": "bun run --cwd apps/mobile ios",
		"mobile:android": "bun run --cwd apps/mobile android",
		"build": "turbo build",
		"lint": "bunx biome check --write --unsafe . --error-on-warnings",
		"ts": "turbo --output-logs=errors-only ts",
		"ok": "bun ts && bun lint && bun test",
		"e2e": "bun run --cwd apps/e2e test",
		"e2e:ui": "bun run --cwd apps/e2e test:ui",
		"e2e:headed": "bun run --cwd apps/e2e test:headed",
		"knip": "knip",
		"tsw": "turbo tsw",
		"setup": "bun ./packages/tools/setup-production.ts",
		"db:init": "bun ./packages/tools/db-init.ts",
		"db:studio": "bun run --cwd packages/server db:studio",
		"db:generate": "bun run --cwd packages/server db:generate",
		"db:migrate": "bun run --cwd packages/server db:migrate",
		"env": "bunx vercel env pull",
		"prepare": "husky",
		"pre-commit": "bun ok && git add -u"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@playwright/test": "1.57.0",
		"@types/bun": "1.3.5",
		"@types/node": "24.10.1",
		"@workspace/typescript-config": "workspace:*",
		"husky": "9.1.7",
		"knip": "5.78.0",
		"turbo": "2.7.2",
		"typescript": "5.9.3"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"react": "19.2.0",
			"react-dom": "19.2.0",
			"@types/react": "19.2.2",
			"@types/react-dom": "19.2.2",
			"typescript": "5.9.3",
			"lucide-react": "0.552.0",
			"zod": "4.1.12",
			"@orpc/client": "1.11.3",
			"@orpc/contract": "1.11.3",
			"@orpc/server": "1.11.3",
			"next": "16.0.1",
			"server-only": "0.0.1"
		}
	},
	"engines": {
		"node": ">=20"
	}
}
